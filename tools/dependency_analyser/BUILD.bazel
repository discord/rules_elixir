# NOTE: this rule specifically *does not* use mix, allowing us to use it to
# bootstrap rules_elixir
load("@rules_elixir//:defs.bzl", "elixir_app", "ex_unit_test")
load("@rules_erlang//:escript.bzl", "escript_archive", "escript_wrapper")

package(default_visibility = [ "//visibility:public"])

elixir_app(
    srcs = [
        "lib/dependency_analyser.ex",
        "lib/dependency_analyser/cargo_toml.ex",
        "lib/dependency_analyser/seed_lock.ex",
    ],
    app_name = "dependency_analyser",
    deps = [
        "@rules_elixir//elixir:elixir",
        "@rules_elixir//elixir:hex",
        "@rules_elixir//elixir:logger",
        "@rules_elixir//elixir:mix",
        "@rules_elixir//elixir:eex",
        "@jason//:erlang_app",
    ],
)

escript_archive(
    name = "dependency_analyser_inner",
    # NOTE: this is hard-coded in upstream rules_elixir.
    # Namespacing is kept sane through directory structure.
    app = ":erlang_app",
    headers = [
        "shebang",
        '{emu_args, "-escript main Elixir.DependencyAnalyser -hidden"}',
    ],
)

escript_wrapper(
    name = "dependency_analyser",
    escript = "dependency_analyser_inner",
    out = "dependency_analyser",
)

TEST_ENV = {
    "ERL_COMPILER_OPTIONS": "deterministic",
    "ELIXIR_ERL_OPTIONS": "+fnu",
}

ex_unit_test(
    name = "cargo_toml_test",
    srcs = ["test/cargo_toml_test.exs"],
    data = ["lib/dependency_analyser/cargo_toml.ex"],
    env = TEST_ENV,
)

ex_unit_test(
    name = "seed_lock_test",
    srcs = [
        "test/test_helper.exs",
        "test/seed_lock_test.exs",
    ],
    data = ["lib/dependency_analyser/seed_lock.ex"],
    env = TEST_ENV,
)

# NOTE: the heavy-mode cases run the git on PATH against a local repository.
ex_unit_test(
    name = "dependency_analyser_test",
    srcs = [
        "test/test_helper.exs",
        "test/dependency_analyser_test.exs",
    ],
    env = TEST_ENV,
    tools = [":dependency_analyser"],
)
